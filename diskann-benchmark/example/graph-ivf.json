{
  "search_directories": ["test_data/disk_index_search"],
  "jobs": [
    {
      "type": "graph-ivf-build",
      "content": {
        "dataset": {
          "data": "disk_index_siftsmall_learn_256pts_data.fbin",
          "queries": "disk_index_sample_query_10pts.fbin",
          "groundtruth": "disk_index_10pts_idx_uint32_exact_ground_truth.bin"
        },
        "build": {
          "initial_centroids": 8,
          "batch_size": 64,
          "split_threshold": 64,
          "two_means_iterations": 5,
          "seed": 7,
          "repetitions": 3
        },
        "graph": {
          "max_degree": 16,
          "l_build": 64
        },
        "search": {
          "k": 10,
          "nprobe": [1, 4, 16],
          "l_search": 64,
          "warmup_repetitions": 1,
          "repetitions": 5
        }
      }
    }
  ]
}
