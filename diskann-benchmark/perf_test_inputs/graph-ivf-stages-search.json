{
  "search_directories": ["test_data/yfcc"],
  "jobs": [
    {
      "type": "graph-ivf-build",
      "content": {
        "dataset": {
          "data": "yfcc_10k.fbin",
          "queries": "yfcc_query_100.fbin",
          "groundtruth": "groundtruth.bin"
        },
        "build": {
          "initial_centroids": 16,
          "batch_size": 4096,
          "split_threshold": 2048,
          "two_means_iterations": 5,
          "seed": 7,
          "repetitions": 3
        },
        "graph": {
          "max_degree": 16,
          "l_build": 64
        },
        "search": {
          "k": 10,
          "nprobe": [4, 16, 64],
          "l_search": 128,
          "warmup_repetitions": 1,
          "repetitions": 2
        }
      }
    }
  ]
}
